"""Type stubs for the compiled `strata_graph._native` module (see src/lib.rs).

Query methods return JSON strings; `strata_graph.Graph` decodes them.
"""

__version__: str

class StrataError(Exception):
    """Raised for any strata-graph failure."""

class NativeGraph:
    @property
    def root(self) -> str: ...
    def refresh(self) -> str: ...
    def stale_files(self) -> int: ...
    def stats(self) -> str: ...
    def find(self, query: str) -> str: ...
    def search(self, query: str, limit: int = 20) -> str: ...
    def node(self, symbol: str) -> str: ...
    def callers(self, symbol: str, depth: int = 1, min_tier: str = "t0") -> str: ...
    def callees(self, symbol: str, depth: int = 1, min_tier: str = "t0") -> str: ...
    def impact(self, symbol: str, depth: int = 3, min_tier: str = "t0") -> str: ...
    def context(self, symbol: str, max_tokens: int = 1500, min_tier: str = "t0") -> str: ...
    def path(
        self, source: str, target: str, max_depth: int = 8, min_tier: str = "t0"
    ) -> str | None: ...

def open(path: str = ".", auto_refresh: bool = True) -> NativeGraph: ...
